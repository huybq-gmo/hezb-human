# Copy to web/.env.local. Next.js and the admin scripts load it from web/.
# Required: Project URL and ONE public API key from the same project.
# Cloud: https://YOUR_PROJECT_REF.supabase.co; local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative; leave empty when using a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only needed for pnpm setup:supabase (database migrations).
# Copy the Direct connection or Session pooler connection string (port 5432).
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Keep [YOUR-PASSWORD] in the URL when supplying the separate password below.
SUPABASE_DB_URL=
# In Next.js env files, escape a literal dollar sign as \$.
SUPABASE_DB_PASSWORD=""
# Optional: confirmed Auth user's email for bootstrapping the first Owner.
# Alternatively pass --owner-email EMAIL to setup:supabase.
SUPABASE_OWNER_EMAIL=

# Optional: 1 enables demo in development; 0 uses the normal app.
# pnpm dev:demo sets this automatically and needs no Supabase credentials.
NEXT_PUBLIC_HEZB_DEMO=0
