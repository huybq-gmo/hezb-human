# Copy to supabase/functions/.env. Never commit real values.
# Required for email-reminders; use the same cron secret in the caller/Vault.
REMINDER_CRON_SECRET=
RESEND_API_KEY=
# Example: "Hezb ERP <reminders@your-verified-domain.com>"
EMAIL_REMINDER_FROM=""
# Local app URL; replace with the deployed ERP URL for Cloud.
ERP_BASE_URL=http://localhost:3000

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY (or SUPABASE_SECRET_KEYS)
# are supplied by the Supabase Edge runtime, not this custom env file.
# From the repository root, load this file explicitly for local testing:
# supabase functions serve email-reminders --env-file supabase/functions/.env
# For Cloud, configure these four custom variables as Edge Function secrets.
